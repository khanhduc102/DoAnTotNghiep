{
  "info": {
    "name": "DucHome - Authentication",
    "description": "Kiem thu xac thuc va phan quyen DucHome. Chay backend (npm run dev) truoc. Chay tung thu muc theo thu tu 1 -> 4, hoac bam Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "password",
      "value": "123456"
    },
    {
      "key": "tenantToken",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "newUserToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Dang ky",
      "item": [
        {
          "name": "Dang ky TENANT moi (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman{{$timestamp}}@duchome.vn\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Nguoi Dung Postman\",\n  \"role\": \"TENANT\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tra ve 201', () => pm.response.to.have.status(201));",
                  "pm.test('Co token, khong lo mat khau', () => { const d = pm.response.json().data; pm.expect(d.token).to.be.a('string'); pm.expect(d.user).to.not.have.property('password'); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.collectionVariables.set('newUserToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Dang ky role ADMIN bi chan (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hacker{{$timestamp}}@duchome.vn\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Gia Mao Admin\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tra ve 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dang ky trung email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tenant1@duchome.vn\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Trung Email\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tra ve 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dang ky du lieu sai (400, loi tung truong)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khong-phai-email\",\n  \"password\": \"12\",\n  \"fullName\": \"A\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tra ve 400', () => pm.response.to.have.status(400));",
                  "pm.test('Co danh sach loi theo field', () => pm.expect(pm.response.json().errors.length).to.be.at.least(3));"
                ]
              }
            }
          ]
        }
      ]
    },
