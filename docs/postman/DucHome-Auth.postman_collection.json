        {
          "name": "GET /auth/me voi tenantToken (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tenantToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tra ve 200', () => pm.response.to.have.status(200));",
                  "pm.test('Dung role TENANT', () => pm.expect(pm.response.json().data.role).to.eql('TENANT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me khong token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
